{
  "manifest_version": 3,
  "name": "Atendimento MC Sul",
  "description": "Central de Atendimento — Betha Sistemas | Médias Contas Região Sul",
  "version": "1.0",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Atendimento MC Sul"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
